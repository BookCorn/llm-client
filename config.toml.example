# GPUI Chat 应用配置文件
#
# 将此文件复制为 config.toml 并根据需要修改
#
# 配置文件位置（按优先级）：
# 1. 命令行指定的路径: --config path/to/config.toml
# 2. ./config.toml（当前目录）
# 3. ~/.config/gpui-test/config.toml（用户配置目录）

#═══════════════════════════════════════════════════════════════════════════
# 应用信息
#═══════════════════════════════════════════════════════════════════════════

[app]
name = "GPUI Chat"
version = "0.1.0"

#═══════════════════════════════════════════════════════════════════════════
# Provider 配置
#═══════════════════════════════════════════════════════════════════════════

# OpenAI Provider（默认）
[[providers]]
name = "openai-default"
type = "openai"
enabled = true

[providers.config]
# API Key（必填）- 本地存储，后续将支持加密
api_key = "sk-your-api-key-here"

# API Base URL（可选）- 用于自定义端点或代理
# api_base = "https://api.openai.com/v1"

# 默认模型
model = "gpt-4"

# Responses API 配置
[providers.config.responses_api]
enabled = true
reasoning_effort = "medium"  # low, medium, high
reasoning_summary = "auto"   # auto, always, never

# 工具配置
[providers.config.tools]
enabled = true
approval_policy = "safe"  # auto, safe, require
max_tool_rounds = 5

# 重试配置
[providers.config.retry]
max_attempts = 3
base_delay_ms = 1000
max_delay_ms = 60000
jitter_ms = 500

# 超时配置
[providers.config.timeout]
request_timeout_secs = 120
stream_idle_timeout_secs = 30

# 遥测配置
[providers.config.telemetry]
enabled = false

# 生成配置
[providers.config.generation]
preset = "balanced"  # precise, balanced, creative, concise, detailed
# temperature = 0.7
# top_p = 1.0
# frequency_penalty = 0.0
# presence_penalty = 0.0
# max_tokens = 4096

#───────────────────────────────────────────────────────────────────────────
# OpenAI Provider（创意模式）
#───────────────────────────────────────────────────────────────────────────

[[providers]]
name = "openai-creative"
type = "openai"
enabled = false

[providers.config]
api_key = "sk-your-api-key-here"
model = "gpt-4"

[providers.config.generation]
preset = "creative"
temperature = 0.9
top_p = 0.95

#───────────────────────────────────────────────────────────────────────────
# Azure OpenAI Provider 示例
#───────────────────────────────────────────────────────────────────────────

[[providers]]
name = "azure-openai"
type = "azureopenai"
enabled = false

[providers.config]
api_key = "your-azure-api-key"
api_base = "https://your-resource.openai.azure.com"
model = "gpt-4"

# Azure 特定配置
[providers.config.extra]
api_version = "2024-02-15-preview"
deployment_name = "gpt-4-deployment"

#───────────────────────────────────────────────────────────────────────────
# Anthropic Claude Provider 示例
#───────────────────────────────────────────────────────────────────────────

[[providers]]
name = "anthropic"
type = "anthropic"
enabled = false

[providers.config]
api_key = "your-anthropic-api-key"
model = "claude-3-opus-20240229"

#═══════════════════════════════════════════════════════════════════════════
# MCP 配置
#═══════════════════════════════════════════════════════════════════════════

[mcp]
# 是否启用 MCP
enabled = false

# MCP 服务器配置文件路径（可选）
# 如果不指定，将使用默认位置
# servers_config = "path/to/mcp_servers.toml"

#═══════════════════════════════════════════════════════════════════════════
# 会话配置
#═══════════════════════════════════════════════════════════════════════════

[conversation]
# 最大会话历史数量
max_history = 100

# 保留的快照数量
keep_snapshots = 20

# 自动快照配置
[conversation.auto_snapshot]
enabled = true
interval = 10  # 每 10 条消息自动创建快照

#═══════════════════════════════════════════════════════════════════════════
# UI 配置
#═══════════════════════════════════════════════════════════════════════════

[ui]
# 主题
theme = "light"  # light, dark

# 字体大小
font_size = 14.0

# 窗口大小
window_width = 1200.0
window_height = 800.0

#═══════════════════════════════════════════════════════════════════════════
# 存储配置
#═══════════════════════════════════════════════════════════════════════════

[storage]
# 数据目录（可选）
# 如果不指定，将使用默认位置
# data_dir = "~/.local/share/gpui-test"

# 是否加密 API Key（后续功能）
encrypt_api_keys = false

#═══════════════════════════════════════════════════════════════════════════
# 高级配置示例
#═══════════════════════════════════════════════════════════════════════════

# 多个 Provider 示例
# 你可以配置多个 Provider 并根据需要切换

# [[providers]]
# name = "openai-gpt35"
# type = "openai"
# enabled = false
#
# [providers.config]
# api_key = "sk-your-api-key-here"
# model = "gpt-3.5-turbo"
#
# [providers.config.generation]
# preset = "balanced"
# max_tokens = 2048

# [[providers]]
# name = "custom-endpoint"
# type = "custom"
# enabled = false
#
# [providers.config]
# api_key = "your-key"
# api_base = "https://your-custom-endpoint.com/v1"
# model = "your-model"

#═══════════════════════════════════════════════════════════════════════════
# 配置说明
#═══════════════════════════════════════════════════════════════════════════

# Provider 类型：
# - openai: OpenAI API
# - azureopenai: Azure OpenAI Service
# - anthropic: Anthropic Claude
# - custom: 自定义 API 端点

# 生成预设：
# - precise: 精确模式（temp=0.3）- 适合事实查询
# - balanced: 平衡模式（temp=0.7）- 默认，适合大多数场景
# - creative: 创意模式（temp=0.9）- 适合创作和头脑风暴
# - concise: 简洁模式（max_tokens=512）- 简短回答
# - detailed: 详细模式（max_tokens=4096）- 详细回答

# 审批策略：
# - auto: 自动执行所有工具
# - safe: 自动执行安全工具，危险工具需要确认
# - require: 所有工具都需要确认

# Reasoning Effort：
# - low: 快速响应，较少推理
# - medium: 平衡响应速度和质量
# - high: 深度推理，响应较慢

# 注意事项：
# 1. API Key 敏感信息，请勿分享配置文件
# 2. 建议将 config.toml 添加到 .gitignore
# 3. 可以为不同场景创建多个 Provider
# 4. enabled = false 的 Provider 不会被使用
